{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noriter AI",
  "version": "0.1.4",
  "identifier": "ai.noriter.desktop",
  "build": {
    "frontendDist": "../dart_ui/build/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Noriter AI",
        "width": 1000,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
